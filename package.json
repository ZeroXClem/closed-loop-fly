{
  "name": "closed-loop-fly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A sensorimotor loop through the male Drosophila connectome, in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nix develop -c vite",
    "build": "nix develop -c vite build",
    "preview": "nix develop -c vite preview",
    "bench": "npm run bench:overlap && npm run bench:edges && npm run bench:annotations",
    "bench:overlap": "nix develop -c node bench/overlap.mjs",
    "bench:edges": "nix develop -c node --max-old-space-size=4096 bench/edges.mjs",
    "bench:annotations": "nix develop -c python bench/annotations.py",
    "bench:inject": "nix develop -c node bench/inject.mjs",
    "bench:gpu": "nix develop -c node bench/browser.mjs",
    "bench:webgpu-probe": "nix develop -c node bench/webgpu-probe.mjs",
    "npm-deps-hash": "nix develop -c sh -c 'prefetch-npm-deps package-lock.json > nix/npm-deps-hash'",
    "vite:build": "vite build",
    "bench:eye": "nix develop -c node bench/eye.mjs",
    "bench:parity": "nix develop -c node bench/parity.mjs",
    "gen:columns": "nix develop -c node scripts/gen-columns.mjs",
    "bench:optic-settle": "nix develop -c node bench/optic-settle.mjs",
    "bench:optic-drum": "nix develop -c node bench/optic-drum.mjs",
    "bench:paths": "nix develop -c node --max-old-space-size=4096 bench/paths.mjs",
    "bench:bridge": "nix develop -c node bench/bridge.mjs",
    "bench:motor": "nix develop -c node bench/motor.mjs",
    "bench:cruise": "nix develop -c node bench/cruise.mjs",
    "bench:ablate": "nix develop -c node bench/ablate.mjs",
    "bench:hs-inject": "nix develop -c node --max-old-space-size=4096 bench/hs-inject.mjs",
    "report:ablations": "nix develop -c node bench/ablate-report.mjs"
  },
  "dependencies": {
    "@huggingface/kernels": "0.0.1-preview.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "puppeteer-core": "^24.0.0"
  }
}
